ALLOWED_HOSTS=localhost,127.0.0.1,gym-backend-xi-seven.vercel.app,.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,https://gym-member-and-admin.vercel.app,https://smart-gym-three.vercel.app
FRONTEND_URL=http://localhost:5173,https://gym-member-and-admin.vercel.app

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=False

# Moyasar — Dashboard → Settings → API Keys (use pk_test_/sk_test_ until go-live)
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Same value as the "secret token" set on the webhook in the Moyasar dashboard
MOYASAR_WEBHOOK_SECRET=

CSRF_TRUSTED_ORIGINS=https://gym-backend-xi-seven.vercel.app,https://gym-member-and-admin.vercel.app,https://smart-gym-three.vercel.app

# Cloudinary (media uploads: registration photos, avatars) - takes priority over R2.
# Dashboard > Settings > API Keys. Leave CLOUDINARY_CLOUD_NAME blank to use R2 / local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-gym
# authenticated = private, served via signed URLs (recommended for face photos)
CLOUDINARY_DELIVERY_TYPE=authenticated

# Cloudflare R2 (media uploads) — optional. Leave R2_ACCESS_KEY_ID blank to store
# uploads on local disk (./media). Set all four to switch to R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Email (SendGrid over SMTP). Leave EMAIL_BACKEND unset locally to print emails to the console.
# In production the console backend is refused for welcome emails (they contain a temporary password).
# Production only (set in Vercel):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
# Must be a sender verified in SendGrid (Settings > Sender Authentication)
DEFAULT_FROM_EMAIL=Smart Gym <no-reply@your-domain.com>

# Copy to .env (same folder) and fill in.

# Backend API. Local: http://localhost:8000/api  —  Production: https://gym-backend-xi-seven.vercel.app/api
API_BASE_URL=http://localhost:8000/api

# A staff account (is_staff, or role admin/manager) used only by this gate.
# Use a dedicated account with a strong password — not your personal admin login.
GATE_STAFF_EMAIL=
GATE_STAFF_PASSWORD=

# SFace cosine similarity needed to grant entry (OpenCV's recommended value: 0.363).
# Raise it to be stricter (fewer false accepts, more false rejects).
MATCH_THRESHOLD=0.363

# Webcam index (0 = built-in; try 1, 2… for USB cameras)
CAMERA_INDEX=0

# Shown on the check-in record
GATE_FACILITY=Main Entrance
